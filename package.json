{
  "name": "conductor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "conductor": "bun src/index.ts",
    "start": "bun src/index.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/ && eslint src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun test tests/unit/",
    "test:watch": "bun test --watch tests/unit/",
    "test:integration": "bun test tests/integration/scenarios/ --timeout=120000",
    "test:e2e": "bun test tests/e2e/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "eslint": "^10.4.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1"
  }
}
