{
  "name": "conductor",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "conductor": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "vitest": "^2.1.8",
    "typescript": "^5.7.3",
    "@types/bun": "latest"
  }
}
